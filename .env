# PostgreSQL connection string — from Supabase, Railway, Neon, or your own Postgres.
DATABASE_URL="postgresql://user:password@host:5432/kadi"

# Any long random string — used to sign login session cookies.
# Generate one with: openssl rand -base64 32
JWT_SECRET="replace-with-a-long-random-string"

# From your Paystack dashboard (Settings -> API Keys & Webhooks).
# Needed for Mobile Money billing (MTN MoMo, Vodafone Cash, AirtelTigo).
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxx"
